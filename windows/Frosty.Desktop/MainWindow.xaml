<Window x:Class="Frosty.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Frosty" Width="1440" Height="900" MinWidth="1080" MinHeight="680" Background="{StaticResource AppBackground}" Foreground="#F4F5FA" WindowStartupLocation="CenterScreen">
  <Grid Margin="12">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,10">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="❄ FROSTY" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="4,0,18,0"/>
          <Button Content="New project" Click="NewProject_Click"/><Button Content="Open .frosty" Click="OpenProject_Click"/><Button Content="Save" Click="SaveProject_Click"/><Button Content="Save as…" Click="SaveAs_Click"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <TextBlock Text="NATIVE CORE" Foreground="{StaticResource MutedText}" VerticalAlignment="Center" Margin="10,0,4,0"/><Border Background="#253C36" CornerRadius="5" Padding="7,4"><TextBlock Text="Phase 1" Foreground="#8FE0B9" FontWeight="SemiBold"/></Border>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/><ColumnDefinition Width="270"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,8,0">
        <StackPanel><TextBlock Text="PROJECT" FontSize="12" FontWeight="Bold" Foreground="{StaticResource MutedText}" Margin="0,0,0,12"/><TextBlock Text="Media &amp; assets" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Imported media will appear here. Phase 1 establishes the native project format and asset identities." TextWrapping="Wrap" Foreground="{StaticResource MutedText}" Margin="0,8,0,16"/><Separator Background="{StaticResource PanelBorder}"/><TextBlock Text="PROJECT MODEL" FontSize="12" FontWeight="Bold" Foreground="{StaticResource MutedText}" Margin="0,16,0,8"/><TextBlock Text="Stable IDs"/><TextBlock Text="Schema migrations"/><TextBlock Text="Atomic saves"/><TextBlock Text="Recovery snapshots"/></StackPanel>
      </Border>
      <Grid Grid.Column="1" Margin="0,0,8,0">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="210"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#080B12" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="10" Margin="0,0,0,8">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440">
            <TextBlock Text="FROSTY NATIVE EDITOR" FontSize="24" FontWeight="SemiBold" Foreground="#E5E4FF" HorizontalAlignment="Center"/>
            <TextBlock Text="C++ timeline model · C# WPF workspace · FFmpeg integration follows in the next phases" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource MutedText}" Margin="0,12,0,0"/>
            <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,24,0,0"><StackPanel><TextBlock Text="Project status" FontWeight="SemiBold"/><TextBlock x:Name="ProjectSummary" Text="Creating native project…" Foreground="{StaticResource MutedText}" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel></Border>
          </StackPanel>
        </Border>
        <Border Grid.Row="1" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="10" Padding="12">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><TextBlock Text="TIMELINE / TRACK MODEL" FontSize="12" FontWeight="Bold" Foreground="{StaticResource MutedText}"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="+ Video track" Click="AddVideoTrack_Click"/><Button Content="+ Audio track" Click="AddAudioTrack_Click"/><Button Content="Lock / unlock" Click="ToggleLock_Click"/><Button Content="Mute / unmute" Click="ToggleMute_Click"/><Button Content="Undo" Click="Undo_Click"/><Button Content="Redo" Click="Redo_Click"/></StackPanel></DockPanel><ListView x:Name="TimelineTracks" Grid.Row="1" Margin="0,10,0,8" Background="#111621" BorderBrush="{StaticResource PanelBorder}" Foreground="#F4F5FA"><ListView.View><GridView><GridViewColumn Header="Track" DisplayMemberBinding="{Binding Name}" Width="180"/><GridViewColumn Header="Type" DisplayMemberBinding="{Binding Type}" Width="80"/><GridViewColumn Header="Order" DisplayMemberBinding="{Binding Order}" Width="70"/><GridViewColumn Header="State" DisplayMemberBinding="{Binding State}" Width="120"/><GridViewColumn Header="Clips" DisplayMemberBinding="{Binding ClipCount}" Width="70"/></GridView></ListView.View></ListView><TextBlock Grid.Row="2" Text="Phase 1 exposes the canonical model and validated track operations. Native video playback, clip placement UI and export remain later-phase work." Foreground="{StaticResource MutedText}" TextWrapping="Wrap" FontSize="11" Margin="2,2,2,0"/></Grid>
        </Border>
      </Grid>
      <Border Grid.Column="2" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="10" Padding="14">
        <StackPanel><TextBlock Text="INSPECTOR" FontSize="12" FontWeight="Bold" Foreground="{StaticResource MutedText}" Margin="0,0,0,12"/><TextBlock Text="Sequence settings" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Resolution" Foreground="{StaticResource MutedText}" Margin="0,14,0,4"/><TextBlock x:Name="ResolutionText" Text="1920 × 1080"/><TextBlock Text="Frame rate" Foreground="{StaticResource MutedText}" Margin="0,12,0,4"/><TextBlock x:Name="FrameRateText" Text="30 / 1 fps"/><TextBlock Text="Color space" Foreground="{StaticResource MutedText}" Margin="0,12,0,4"/><TextBlock x:Name="ColorSpaceText" Text="BT.709 · Limited range"/><Separator Background="{StaticResource PanelBorder}" Margin="0,18,0,12"/><TextBlock Text="Validation" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Project IDs, track references, source ranges and sequence references are validated by the native engine on load/save." Foreground="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
      </Border>
    </Grid>
    <Border Grid.Row="2" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,10,0,0"><DockPanel><TextBlock x:Name="StatusText" Text="Ready" Foreground="{StaticResource MutedText}"/><TextBlock DockPanel.Dock="Right" Text="Frosty · Native migration in progress" Foreground="{StaticResource MutedText}"/></DockPanel></Border>
  </Grid>
</Window>
