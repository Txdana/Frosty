<Application x:Class="Frosty.Desktop.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="AppBackground" Color="#10131C" />
    <SolidColorBrush x:Key="PanelBackground" Color="#191E2B" />
    <SolidColorBrush x:Key="PanelBorder" Color="#30384B" />
    <SolidColorBrush x:Key="Accent" Color="#8B7CFF" />
    <SolidColorBrush x:Key="MutedText" Color="#AAB3C7" />
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#F4F5FA"/><Setter Property="Background" Value="#292F42"/><Setter Property="BorderBrush" Value="#414A62"/><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="3"/><Setter Property="Cursor" Value="Hand"/>
    </Style>
  </Application.Resources>
</Application>
