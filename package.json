{
  "name": "frosty",
  "productName": "Frosty",
  "version": "1.3.0",
  "description": "Frosty - an AI-assisted video editor for Windows",
  "main": "main.js",
  "license": "Apache-2.0",
  "scripts": {
    "start": "electron .",
    "test": "node test/ffmpeg-license-boundary.js && node test/run-all.js",
    "dist": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-native.ps1",
    "dist:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-native.ps1",
    "test:media": "node test/media-workflow.js && node test/sequence-render-runtime.js",
    "test:analysis": "node test/analysis-static.js && node test/color-audio-production.js && node test/scene-index.js",
    "test:brag-reach": "node test/brag-reach.js",
    "test:agent-safety": "node test/agent-safety.js",
    "test:frame-preview": "node test/frame-preview-playback.js",
    "test:effects": "node test/effect-stack-static.js && node test/effect-stack-runtime.js",
    "test:color-audio": "node test/analysis-static.js && node test/color-audio-production.js",
    "test:reach": "node test/brag-reach.js",
    "test:bezier-mask": "node test/bezier-mask-runtime.js",
    "test:project-format": "node test/project-format.js",
    "native:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-native.ps1",
    "electron:dist": "electron-builder --win nsis portable",
    "electron:dist:win": "electron-builder --win nsis",
    "test:native-render": "node test/native-transform-render.js",
    "test:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File test/windows-e2e.ps1",
    "test:native": "cmake -S native -B native/build-test-runner -DCMAKE_BUILD_TYPE=Release && cmake --build native/build-test-runner --config Release --parallel 2 && ctest --test-dir native/build-test-runner -C Release --output-on-failure",
    "test:semantic-search": "node test/scene-index.js && node test/embedding-client.js"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "app.frosty.editor",
    "productName": "Frosty",
    "files": [
      "assets/**",
      "main.js",
      "preload.js",
      "lib/**",
      "renderer/**",
      "scripts/**",
      "package.json",
      "LICENSE",
      "NOTICE",
      "THIRD_PARTY_NOTICES.md",
      "RUNTIME_REQUIREMENTS.md"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/frosty.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Frosty",
      "uninstallDisplayName": "Frosty",
      "artifactName": "Frosty-Setup-${version}.${ext}",
      "include": "build/installer.nsh"
    },
    "artifactName": "Frosty-${version}-${arch}.${ext}",
    "extraResources": [
      {
        "from": "scripts/install-ffmpeg.ps1",
        "to": "scripts/install-ffmpeg.ps1"
      }
    ]
  }
}
